{
  "name": "homing",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1 --port 1420 --strictPort",
    "test": "node --test src/*.test.js",
    "test:browser": "vp exec playwright test",
    "tauri": "tauri",
    "icons": "node scripts/tray-icons.mjs",
    "build:app": "pwsh -NoProfile -File scripts/with-build-cache.ps1 vp exec tauri build --ci --no-bundle -- --locked",
    "test:rust": "pwsh -NoProfile -File scripts/with-build-cache.ps1 cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "linen-ui": "git+https://github.com/Hezric/Linen.git#v0.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  }
}
